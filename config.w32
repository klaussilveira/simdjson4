ARG_ENABLE("simdjson4", "whether to enable simdjson4 support", "no");

if (PHP_SIMDJSON4 == "yes") {
  AC_DEFINE('HAVE_SIMDJSON4', 1, 'Have simdjson4 support', false);

  // NOTE: The linker requires that the files have different basenames, so simdjson.cpp was
  // renamed to php_simdjson.cpp
  EXTENSION('simdjson4',
    'php_simdjson.cpp',
    'yes',
    '/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1 /std:c++latest');
  ADD_SOURCES(configure_module_dirname + '/src', 'simdjson.cpp simdjson_bindings.cpp simdjson_encoder.cpp', 'simdjson4');
  ADD_EXTENSION_DEP('simdjson4', 'json');
  ADD_FLAG('CFLAGS_SIMDJSON4', '/I' + configure_module_dirname);
  PHP_INSTALL_HEADERS('ext/simdjson4', 'php_simdjson.h src/simdjson_bindings_defs.h');
}
// vim:ft=javascript
